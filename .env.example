# Copy this file to ".env" and fill in your real values.
# Find both of these in your Supabase project dashboard:
# Project Settings -> API

# Your project's unique URL, looks like https://abcdefghijk.supabase.co
VITE_SUPABASE_URL=

# The "anon" / "public" key (NOT the "service_role" key - never put that in frontend code)
VITE_SUPABASE_ANON_KEY=
